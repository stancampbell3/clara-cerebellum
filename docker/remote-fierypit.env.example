# Standalone remote FieryPit — env template.
#
# Copy to remote-fierypit.env on the REMOTE host (not the Dis host) and
# fill in real values, then:
#   docker compose -f docker-compose.remote-fierypit.yml \
#     --env-file remote-fierypit.env up -d
#
# DIS_DOMAIN_PEER_TOKEN and LILDAEMON_SERVICE_SECRET must be copied
# VERBATIM from the Dis host's own docker/.env — they're shared secrets,
# not per-host values.

# --- This host's own identity, as reachable from the Dis host and peers ---
# The lildaemon service runs with network_mode: host (see docker-compose.
# remote-fierypit.yml's comment on why) -- it binds directly to this
# host's own port 6666, no port-mapping override available.
LILDAEMON_BASE_URL=http://pineal:6666

# --- Where Dis (clara-api) lives ---
DIS_BASE_URL=http://limbic:8080

# --- Shared secrets (copy verbatim from the Dis host's docker/.env) ---
LILDAEMON_JWT_SECRET=change-me
LILDAEMON_SERVICE_SECRET=change-me
DIS_DOMAIN_PEER_TOKEN=change-me
# DIS_DOMAIN=dis.local   # must match the Dis host's config/default.toml server.dis_domain_id

# --- Optional, only if this host's evaluators need them ---
# GROQ_API_KEY=
# GOOGLE_CUSTOM_SEARCH_API_KEY=
# GOOGLE_CUSTOM_SEARCH_CX=
# EDGEQUAKE_BASE_URL=
# EDGEQUAKE_API_KEY=
