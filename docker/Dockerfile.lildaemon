# lildaemon (FieryPit) — Python 3.11 service
#
# Build context: Development/ (parent of lildaemon/)
# Run from: /app  (so config/evaluators.yaml and evaluators_custom/ resolve correctly)

FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependency layer FIRST, keyed only on pyproject.toml, so source-only
# changes don't re-download the whole dependency tree (previously every
# `COPY lildaemon/ .` invalidated the single pip layer and rebuilds took
# ~30 minutes; a PyPI CDN read timeout killed two such builds in a row on
# 2026-08-27 — hence also the explicit retries/timeout).
COPY lildaemon/pyproject.toml ./pyproject.toml
RUN python -c "import tomllib; print('\n'.join(tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']))" > /tmp/requirements.txt \
    && pip install --no-cache-dir --retries 10 --timeout 120 -r /tmp/requirements.txt

# Copy the full lildaemon tree to /app.
# evaluators_custom/ and config/ must be present in the working directory.
COPY lildaemon/ .

# Create logs directory expected by the logging config
RUN mkdir -p /app/logs

# Install the goat package itself (deps already satisfied above; packages
# found via pyproject [tool.setuptools] / setup.cfg: include = goat*).
RUN pip install --no-cache-dir --no-deps -e .

EXPOSE 6666

ENV CEREBELLUM_URL=http://clara-api:8080

CMD ["uvicorn", "goat.app.main:app", "--host", "0.0.0.0", "--port", "6666"]
